{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jwlab",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_PUBLIC_SITE_URL": "https://jwlab.figur.workers.dev",
    "R2_PUBLIC_BASE_URL": "https://jwlab.figur.workers.dev/api/assets",
    "BCE_API_URL": "https://www.bcexp.id",
    "RAJAONGKIR_API_URL": "https://rajaongkir.komerce.id/api/v1",
    "RAJAONGKIR_ORIGIN_ID": "73330",
    "GEOCODER_API_URL": "https://nominatim.openstreetmap.org",
    "NUXT_PUBLIC_BCE_TRACKING_URL": "https://www.bcexp.id/track"
  },
  "assets": { "directory": ".output/public" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jwlab-studio",
      "database_id": "5ad8db2b-5322-4c8f-8091-e302893c5e61",
      "migrations_dir": "database/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PRODUCT_IMAGES", "bucket_name": "jwlab-studio-product-images" }
  ],
  "queues": {
    "producers": [
      { "binding": "SHIPMENT_QUEUE", "queue": "jwlab-studio-shipments" },
      { "binding": "TRACKING_QUEUE", "queue": "jwlab-studio-tracking" }
    ]
  }
}
