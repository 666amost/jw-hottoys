{
  "name": "jwlab-studio-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:cloudflare": "nuxt dev",
    "build": "nuxt build",
    "preview": "npm run build && wrangler dev --config wrangler.web.jsonc",
    "deploy": "npm run build && wrangler deploy --config wrangler.web.jsonc",
    "deploy:operations": "wrangler deploy --config wrangler.operations.jsonc",
    "typecheck": "nuxt typecheck",
    "typecheck:workers": "tsc --noEmit -p tsconfig.workers.json",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=low",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:setup": "node scripts/setup-env.mjs",
    "regions:build": "node scripts/build-region-data.mjs",
    "db:migrate:local": "node scripts/run-local-d1.mjs migrate",
    "db:seed:local": "node scripts/run-local-d1.mjs seed",
    "db:migrate:local:fallback": "node scripts/d1-local-fallback.mjs migrate",
    "db:seed:local:fallback": "node scripts/d1-local-fallback.mjs seed",
    "db:verify:local": "node scripts/d1-local-fallback.mjs verify",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:create:local": "node scripts/create-admin.mjs local",
    "admin:create:local:fallback": "node scripts/create-admin.mjs local --fallback",
    "admin:create:remote": "node scripts/create-admin.mjs remote",
    "dry-run": "npm run build && wrangler deploy --dry-run --outdir .tmp/web-worker --config wrangler.web.jsonc && wrangler deploy --dry-run --outdir .tmp/operations-worker --config wrangler.operations.jsonc",
    "verify": "npm run audit && npm run typecheck && npm run typecheck:workers && npm run lint && npm run test && npm run build && npm run dry-run"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@zumer/snapdom": "^2.24.1",
    "@zxing/library": "^0.21.3",
    "better-auth": "1.6.24",
    "canvg": "^3.0.11",
    "clsx": "^2.1.1",
    "core-js": "^3.47.0",
    "dompurify": "^3.4.13",
    "drizzle-orm": "0.45.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lottie-web": "^5.13.0",
    "nuxt": "4.5.1",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.6.0",
    "svix": "^1.80.0",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/test-utils": "^3.20.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.20",
    "@types/qrcode": "^1.5.5",
    "eslint": "10.8.0",
    "happy-dom": "^20.0.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "3.2.7",
    "vue-tsc": "^3.1.1",
    "wrangler": "4.122.0"
  }
}
